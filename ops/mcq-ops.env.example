# Install as /etc/mcq-ops.env, owned by root with mode 0600.
# Never commit the populated file.

MCQ_APP_DIR=/var/www/handyant
POSTGRES_DB=handyant
POSTGRES_SUPERUSER=postgres

# Local copies make a fast rollback possible. Off-host storage is mandatory
# before old local copies are pruned.
LOCAL_BACKUP_DIR=/var/backups/mcq
LOCAL_RETENTION_DAYS=7
OFFSITE_RETENTION_DAYS=30
MIN_FREE_KB=1048576

# rclone destination, for example:
#   b2-mcq:mcq-production
#   s3-mcq:company-backups/mcq
#   sftp-backup:mcq-production
OFFSITE_TARGET=

HEALTH_URL=https://mcqpropertycare.com/
HEALTH_EXPECT_TEXT='MCQ Property Care'
HEALTH_TIMEOUT_SECONDS=25
HEALTH_FAILURE_THRESHOLD=2
HEALTH_ALERT_COOLDOWN_SECONDS=21600
HEALTH_STATE_DIR=/run/mcq-health

# Required for unattended email alerts in production. Use a dedicated,
# sending-only key rather than the application's Resend key. If these remain
# empty, health failures are recorded only through systemd exit status/journal.
RESEND_API_KEY=
ALERT_FROM='MCQ Monitor <anthony@mcqpropertycare.com>'
ALERT_TO=
