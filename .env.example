# Required in production.
DATABASE_URL=postgresql://user:password@localhost:5432/mcq
NEXTAUTH_URL=https://mcqpropertycare.com
NEXTAUTH_SECRET=generate-a-long-random-secret
# Generate once with: openssl rand -base64 32
# Back this value up securely. Changing it makes existing encrypted home-access
# values unreadable until they are migrated with the old key.
DATA_ENCRYPTION_KEY=

# Required in production so verification, password reset, booking, message,
# invitation, and reminder email can be delivered.
RESEND_API_KEY=
EMAIL_FROM="Anthony at MCQ <anthony@mcqpropertycare.com>"
EMAIL_REPLY_TO=anthony@mcqpropertycare.com
EMAIL_BCC=me@jordangodfrey.com

# Optional Google login provider. Configure both values or neither.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional local-upload budgets. Defaults are 250 MiB per account and 2 GiB
# total when omitted.
MCQ_UPLOAD_ACCOUNT_LIMIT_BYTES=262144000
MCQ_UPLOAD_GLOBAL_LIMIT_BYTES=2147483648
